<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission
        android:name="com.android.providers.tv.permission.READ_EPG_DATA"
        tools:node="remove" />
    <uses-permission
        android:name="com.android.providers.tv.permission.WRITE_EPG_DATA"
        tools:node="remove" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true"
        tools:ignore="UnsupportedTvHardware" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false"
        tools:replace="android:required" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        tools:node="remove" />

    <application
        android:name=".MobileApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_smarttube"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartTube.Mobile"
        tools:replace="android:theme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.youtube.com" />
                <data android:host="youtube.com" />
                <data android:host="youtu.be" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WatchActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:supportsPictureInPicture="true"
            tools:targetApi="24" />

        <activity android:name=".SearchActivity" android:exported="false" />
        <activity android:name=".ChannelActivity" android:exported="false" />
        <activity android:name=".CollectionActivity" android:exported="false" />

        <service
            android:name=".MobilePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

        <activity
            android:name="com.liskovsoft.leanbackassistant.search.SearchableActivity"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <provider
            android:name="com.liskovsoft.leanbackassistant.search.VideoContentProvider"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="com.liskovsoft.leanbackassistant.channels.UpdateChannelsReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
