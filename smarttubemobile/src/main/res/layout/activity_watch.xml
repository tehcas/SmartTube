<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@color/smarttube_surface">

            <com.google.android.exoplayer2.ui.PlayerView
                android:id="@+id/watch_player"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/black"
                android:keepScreenOn="true" />

            <ImageButton
                android:id="@+id/watch_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|top"
                android:layout_margin="12dp"
                android:background="@drawable/bg_circle_scrim"
                android:contentDescription="@string/back"
                android:padding="13dp"
                android:src="@drawable/ic_back"
                android:tint="@color/smarttube_text_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/watch_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:textColor="@color/smarttube_text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/watch_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="8dp"
            android:paddingEnd="22dp"
            android:textColor="@color/smarttube_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/watch_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="22dp"
            android:background="@color/smarttube_surface"
            android:padding="14dp"
            android:text="@string/playback_service_starting"
            android:textColor="@color/smarttube_text_primary"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/watch_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@string/playback_progress" />

        <TextView
            android:id="@+id/watch_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/playback_position_initial"
            android:textColor="@color/smarttube_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            tools:ignore="ButtonStyle">

            <Button
                android:id="@+id/watch_previous"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/previous"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/watch_play_pause"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/smarttube_accent"
                android:text="@string/play"
                android:textAllCaps="false"
                android:textColor="@color/smarttube_text_primary" />

            <Button
                android:id="@+id/watch_next"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/next"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/watch_queue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="14dp"
            android:paddingEnd="22dp"
            android:textColor="@color/smarttube_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/watch_video_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="14dp"
            android:paddingEnd="22dp"
            android:textColor="@color/smarttube_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/copy_watch_link"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:layout_marginStart="22dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/smarttube_accent"
            android:text="@string/copy_video_link"
            android:textAllCaps="false"
            android:textColor="@color/smarttube_text_primary" />
    </LinearLayout>
</ScrollView>
