<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/watch_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@color/smarttube_surface"
                android:contentDescription="@string/video_thumbnail"
                android:scaleType="centerCrop" />

            <ImageButton
                android:id="@+id/watch_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|top"
                android:layout_margin="12dp"
                android:background="@drawable/bg_circle_scrim"
                android:contentDescription="@string/back"
                android:padding="13dp"
                android:src="@drawable/ic_back"
                android:tint="@color/smarttube_text_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/watch_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:textColor="@color/smarttube_text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/watch_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="8dp"
            android:paddingEnd="22dp"
            android:textColor="@color/smarttube_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="22dp"
            android:background="@color/smarttube_surface"
            android:padding="18dp"
            android:text="@string/player_foundation_message"
            android:textColor="@color/smarttube_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/watch_video_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:textColor="@color/smarttube_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/copy_watch_link"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:layout_marginStart="22dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/smarttube_accent"
            android:text="@string/copy_video_link"
            android:textAllCaps="false"
            android:textColor="@color/smarttube_text_primary" />
    </LinearLayout>
</ScrollView>
