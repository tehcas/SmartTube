<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/watch_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:use_controller="false" />

    <ImageButton
        android:id="@+id/watch_back"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_margin="18dp"
        android:background="@drawable/bg_circle_scrim"
        android:contentDescription="@string/back"
        android:padding="14dp"
        android:src="@drawable/ic_back"
        android:tint="@color/smarttube_text_primary" />

    <LinearLayout
        android:id="@+id/watch_controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/smarttube_scrim"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/watch_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/smarttube_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/watch_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/smarttube_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/watch_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/playback_service_starting"
            android:textColor="@color/smarttube_text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/watch_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/playback_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="ButtonStyle">

            <TextView
                android:id="@+id/watch_position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/playback_position_initial"
                android:textColor="@color/smarttube_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/watch_previous"
                android:layout_width="88dp"
                android:layout_height="44dp"
                android:text="@string/previous"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/watch_rewind"
                android:layout_width="72dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:text="@string/seek_back_initial"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/watch_play_pause"
                android:layout_width="88dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/smarttube_accent"
                android:text="@string/play"
                android:textAllCaps="false"
                android:textColor="@color/smarttube_text_primary" />

            <Button
                android:id="@+id/watch_forward"
                android:layout_width="72dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:text="@string/seek_forward_initial"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/watch_next"
                android:layout_width="72dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:text="@string/next"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/watch_queue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/playback_queue"
                android:textColor="@color/smarttube_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/watch_video_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <Button
        android:id="@+id/copy_watch_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</FrameLayout>
